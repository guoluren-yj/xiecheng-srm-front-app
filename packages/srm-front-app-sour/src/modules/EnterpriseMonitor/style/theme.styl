@import '~srm-mobile-ui/src/style/var.styl';

.hips-view__content {
  -webkit-overflow-scrolling touch
}

.hips-view__header {
  .hips-tabs {
    width 70%
    margin-left 15%

    .hips-tabs__wrapper {
      &:after {
        border-bottom-width 0
      }

      .hips-tab--active {
        color $font-color !important
      }
    }
  }
}

// 平移滑动
.router-slide-in {
  &-leave-active {
    z-index 1;
    position absolute !important;
    width 100%;
    height 100%;
    left 0;
    top 0;
    background white;
    transform: translateX(0)
    transition: transform .4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  &-leave-to {
    transform: translateX(-20%)
  }

  &-enter-active {
    z-index 3;
    position absolute !important;
    width 100%;
    height 100%;
    left 0;
    top 0;
    background white;
    box-shadow 0 2px 12px 0 rgba(0, 0, 0, 0.1);
    transform: translateX(100%)
    transition: transform .45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  &-enter-to {
    transform: translateX(0)
  }
}

.router-slide-out {
  &-leave-active {
    z-index 3;
    position absolute !important;
    width 100%;
    height 100%;
    left 0;
    top 0;
    background white;
    box-shadow 0 2px 12px 0 rgba(0, 0, 0, 0.1);
    transition: transform .45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  &-leave-to {
    transform: translateX(100%)
  }

  &-enter-active {
    z-index 1;
    position absolute !important;
    width 100%;
    height 100%;
    left 0;
    top 0;
    background white;
    transform: translateX(-20%)
    transition: transform .4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  &-enter-to {
    transform: translateX(0)
  }
}

// 缩放
.router-zoom-in {

  &-leave-active, &-leave-to {
    display none;
  }

  &-enter-active{
    transform: scale(0.95, 0.95);
    transition-duration .1s;
    transition-property transform opacity;
    transition-timing-function linear;
  }
  &-enter-to {
    transform: scale(1, 1);
  }
}

.router-zoom-out {
  &-leave-active, &-leave-to {
    display none;
  }

  &-enter-active{
    transform: scale(1.05, 1.05);
    transition-duration .1s;
    transition-property transform opacity;
    transition-timing-function linear;
  }
  &-enter-to {
    transform: scale(1, 1);
  }
}

// 卡片切换滑动
.slide-left {
  &-enter-active {
    animation: slide-left-a .6s
  }
  &-leave-active {
    animation: slide-left-b .6s
    position: absolute
  }
}
.slide-right {
  &-enter-active {
    animation: slide-right-a .6s
  }
  &-leave-active {
    animation: slide-right-b .6s
    position: absolute
  }
}

@keyframes slide-left-a
{
    0%   {transform: translate(100%)}
    100% {transform: translate(0)}
}
@-webkit-keyframes slide-left-a /* Safari 与 Chrome */
{
    0%   {transform: translate(100%)}
    100% {transform: translate(0)}
}
@keyframes slide-left-b
{
    0%   {transform: translate(0)}
    100% {transform: translate(-100%)}
}
@-webkit-keyframes slide-left-b /* Safari 与 Chrome */
{
    0%   {transform: translate(0)}
    100% {transform: translate(-100%)}
}


@keyframes slide-right-a
{
    0%   {transform: translate(-100%)}
    100% {transform: translate(0)}
}
@-webkit-keyframes slide-right-a /* Safari 与 Chrome */
{
    0%   {transform: translate(-100%)}
    100% {transform: translate(0)}
}
@keyframes slide-right-b
{
    0%   {transform: translate(0)}
    100% {transform: translate(100%)}
}
@-webkit-keyframes slide-right-b /* Safari 与 Chrome */
{
    0%   {transform: translate(0)}
    100% {transform: translate(100%)}
}

